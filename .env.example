# ─── Required ────────────────────────────────────────────────────────────────

# Database — Railway's PostgreSQL plugin sets this automatically.
# For local dev: run a PostgreSQL instance and point this at it.
# (The schema is PostgreSQL-only; a SQLite "file:" URL will not connect.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth — generate with: openssl rand -hex 32
# The app REFUSES TO START in production without this, because falling back to
# the built-in development secret would let anyone forge an admin session.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site origin — canonical URLs, Open Graph tags, sitemap.xml, JSON-LD,
# and the links inside transactional emails. Falls back to RAILWAY_PUBLIC_DOMAIN.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Cloudinary — https://cloudinary.com (free tier is plenty to start)
# All school media lives here. Without it, uploads return 503 and schools
# CANNOT COMPLETE REGISTRATION, since a badge and cover photo are required.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Email (strongly recommended) ────────────────────────────────────────────
# Without SMTP, password reset falls back to raising a support ticket for an
# admin to action by hand, and school email verification is unavailable.
# Works with any SMTP provider: Brevo, Zoho, Mailgun, Gmail, or local Mailpit.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="SchoolFinder <no-reply@your-domain.com>"

# ─── Payments (optional) ─────────────────────────────────────────────────────
# Flutterwave covers MTN MoMo, Airtel Money, and cards. Until both values are
# set, the dashboard offers an "upgrade request" instead of a checkout, and no
# subscription can be activated by any client request.
# Webhook URL to register in the Flutterwave dashboard:
#   https://your-domain.com/api/payments/webhook
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# ─── Admin recovery (leave unset normally) ───────────────────────────────────
# Unlocks /auth/setup so an administrator password can be reset from the browser
# when you are locked out. Must be 32+ random characters — a short value is
# ignored and treated as unset.
#   openssl rand -hex 32
# Set it, redeploy, reset your password, then REMOVE IT AGAIN. While it is set,
# anyone holding it can take over the site.
# ADMIN_SETUP_TOKEN=""

# ─── Optional ────────────────────────────────────────────────────────────────

# Identifies the site to OpenStreetMap's Nominatim, whose usage policy requires
# a real contact address. Defaults to a generic SchoolFinder agent.
NOMINATIM_USER_AGENT="SchoolFinder/1.0 (+https://your-domain.com; you@your-domain.com)"

# Numeric App Store ID. Only set once the iOS app is live — it enables the
# Safari Smart App Banner.
# NEXT_PUBLIC_APPLE_APP_ID="123456789"
