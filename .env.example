# Database — Railway PostgreSQL plugin sets this automatically.
# For local dev: run a PostgreSQL instance and point this at it.
# (The schema is PostgreSQL-only; a SQLite "file:" URL will not connect.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth — generate a strong random secret (e.g. openssl rand -hex 32).
# REQUIRED in production: without it the app falls back to a known dev secret,
# which would let anyone forge an admin session.
AUTH_SECRET="replace-with-a-long-random-secret"

# Cloudinary — create a free account at https://cloudinary.com
# All school and site media (badges, cover photos, galleries) is stored here.
# Without these, uploads return 503 and schools cannot complete registration.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public site origin — used for canonical URLs, Open Graph tags, sitemap.xml,
# and JSON-LD. Falls back to RAILWAY_PUBLIC_DOMAIN, then localhost.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional — numeric App Store ID. Only set once the iOS app is published;
# it enables the Safari Smart App Banner.
# NEXT_PUBLIC_APPLE_APP_ID="123456789"
